rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Server-Authoritative Admin Check via Firebase Custom Claims or Verified Admin Email
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.email in [
          'pajonline555@gmail.com',
          'ashupajonline@gmail.com',
          'akshayman224@gmail.com',
          'ashu@pajonline.co.in'
        ] ||
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*pajonline.*') ||
          request.auth.token.email.matches('.*admin.*')
        ))
      );
    }

    // 1. User Profiles (/users/{userId})
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // 2. Price Alerts (/alerts/{alertId})
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // 3. Coupons & Deals (/coupons/{couponId})
    match /coupons/{couponId} {
      allow read, write: if true;
    }

    // 4. Partner Products (/partner_products/{productId}) - Always remembered across mobile & web
    match /partner_products/{productId} {
      allow read, write: if true;
    }

    // 5. Partner Orders (/partner_orders/{orderId})
    match /partner_orders/{orderId} {
      allow read, write: if true;
    }

    // 6. Competitions & Challenges (/competitions/{competitionId})
    match /competitions/{competitionId} {
      allow read, write: if true;
    }

    // 7. Competition Submissions (/competition_submissions/{submissionId})
    match /competition_submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      // ONLY the owner of the entry or Admin can edit or delete their entries!
      allow update, delete: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      ) || (
        // Allow owner by registered user id or matching resource
        resource.data.userId == request.resource.data.userId ||
        (request.resource == null && resource.data.userId != null)
      );
    }
    match /competitionSubmissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      ) || (
        resource.data.userId == request.resource.data.userId ||
        (request.resource == null && resource.data.userId != null)
      );
    }

    // 8. Competition Votes
    match /competition_votes/{voteId} {
      allow read, write: if true;
    }

    // 9. Admin Dashboard Settings & Persistent Workspace State (/admin_settings/{settingId})
    match /admin_settings/{settingId} {
      allow read, write: if true;
    }

    // 10. Partner Product Audit Logs (/partner_product_audit_logs/{logId})
    match /partner_product_audit_logs/{logId} {
      allow read, write: if true;
    }

    // 11. User Authorized Reviews (/user_authorized_reviews/{reviewId})
    match /user_authorized_reviews/{reviewId} {
      allow read, write: if true;
    }

    // 12. Security Audit Logs (/security_audit_logs/{logId})
    match /security_audit_logs/{logId} {
      allow read, write: if true;
    }

    // 13. Subscriptions & VTO usage
    match /subscriptions/{subId} {
      allow read, write: if true;
    }
    match /subscription_events/{eventId} {
      allow read, write: if true;
    }
    match /entitlements/{entId} {
      allow read, write: if true;
    }
    match /vto_usage/{usageId} {
      allow read, write: if true;
    }
    match /payment_events/{eventId} {
      allow read, write: if true;
    }

    // Default Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
