rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Server-Authoritative Admin Check via Firebase Custom Claims or Verified Designated Admin Emails
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.role == 'ADMIN' ||
        request.auth.token.email in [
          'pajonline555@gmail.com',
          'ashupajonline@gmail.com',
          'akshayman224@gmail.com',
          'ashu@pajonline.co.in'
        ]
      );
    }
    
    // Helper: Valid Partner Ownership
    function isPartnerOwner(partnerId) {
      return request.auth != null && (
        request.auth.uid == partnerId ||
        request.auth.token.partnerId == partnerId ||
        request.auth.token.email == partnerId
      );
    }

    // Helper: Verify partner has active, approved selling permission in /partners/{partnerId}
    function isApprovedPartner(partnerId) {
      return exists(/databases/$(database)/documents/partners/$(partnerId)) &&
        get(/databases/$(database)/documents/partners/$(partnerId)).data.status == 'APPROVED';
    }

    // Helper: Ensure partner is not tampering with privileged moderation & verification fields
    function hasNoPrivilegedFieldTampering() {
      let incoming = request.resource.data;
      let existing = resource != null ? resource.data : null;

      return (
        // Non-admins can NEVER assign verified_live or verification_stale
        incoming.verificationStatus != 'verified_live' &&
        incoming.verificationStatus != 'verification_stale' &&
        // Non-admins cannot set isLowest or partnerBadge
        (!('isLowest' in incoming) || incoming.isLowest == false) &&
        (!('partnerBadge' in incoming) || incoming.partnerBadge == false) &&
        // Non-admins cannot set verifiedPrice or priceVerifiedAt
        (!('verifiedPrice' in incoming) || incoming.verifiedPrice == null) &&
        (!('priceVerifiedAt' in incoming) || incoming.priceVerifiedAt == null) &&
        // Non-admins cannot alter reviewStatus to APPROVED or SUSPENDED
        incoming.reviewStatus != 'APPROVED' &&
        incoming.reviewStatus != 'SUSPENDED' &&
        // Non-admins cannot publish directly to LIVE status unless already approved by platform admin
        (incoming.status != 'LIVE' || (existing != null && existing.status == 'LIVE' && existing.reviewStatus == 'APPROVED')) &&
        // Non-admins cannot tamper with platform audit scores
        (!('smartValueScore' in incoming) || (existing != null && incoming.smartValueScore == existing.smartValueScore)) &&
        (!('shoppingTrustScore' in incoming) || (existing != null && incoming.shoppingTrustScore == existing.shoppingTrustScore))
      );
    }

    // 1. User Profiles (/users/{userId})
    match /users/{userId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || (request.auth != null && request.auth.uid == userId);
    }
    
    // 2. Price Alerts (/alerts/{alertId})
    match /alerts/{alertId} {
      allow read: if isAdmin() || (request.auth != null && (resource == null || resource.data.userId == request.auth.uid));
      allow create: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid) || (request.resource.data.userId != null);
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // 3. Coupons & Deals (/coupons/{couponId})
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Partner Store Profiles (/partners/{partnerId})
    match /partners/{partnerId} {
      allow read: if true;
      
      // CREATE: Only Admins can grant APPROVED status or set custom commission rates.
      // Non-admins can only submit PENDING applications with standard 15% commission.
      allow create: if isAdmin() || (
        request.auth != null &&
        isPartnerOwner(partnerId) &&
        request.resource.data.status in ['PENDING', 'UNDER_REVIEW'] &&
        (!('commissionValue' in request.resource.data) || request.resource.data.commissionValue == 15) &&
        (!('netPayable' in request.resource.data) || request.resource.data.netPayable == 0) &&
        (!('totalRevenue' in request.resource.data) || request.resource.data.totalRevenue == 0) &&
        (!('totalOrders' in request.resource.data) || request.resource.data.totalOrders == 0)
      );

      // UPDATE: Admins can update any field (including status, commissionValue, settlements).
      // Non-admin partners CANNOT elevate status, self-approve, change commission, or modify financial balances.
      allow update: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(partnerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'brandName', 'companyName', 'phone', 'city', 'state', 'pincode', 
          'address', 'gstNumber', 'description', 'logoUrl', 'bannerUrl', 
          'category', 'socialLinks', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    // 5. Partner Products (/partner_products/{productId})
    match /partner_products/{productId} {
      // Consumers can view approved/live products; partners/admins can view their catalog
      allow read: if true;

      // Create: Authenticated partner can create new listings only in unverified / pending state AND partner must be APPROVED
      allow create: if isAdmin() || (
        request.auth != null &&
        isPartnerOwner(request.resource.data.partnerId) &&
        isApprovedPartner(request.resource.data.partnerId) &&
        request.resource.data.verificationStatus == 'unverified' &&
        request.resource.data.reviewStatus in ['DRAFT', 'PENDING_REVIEW'] &&
        request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL'] &&
        request.resource.data.sellingPrice > 0 &&
        request.resource.data.sellingPrice <= request.resource.data.mrp &&
        hasNoPrivilegedFieldTampering()
      );

      // Update: Owner can update their own listing only if partner is APPROVED; cannot modify partnerId or privileged fields
      allow update: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId) &&
        isApprovedPartner(resource.data.partnerId) &&
        request.resource.data.partnerId == resource.data.partnerId &&
        hasNoPrivilegedFieldTampering()
      );

      // Delete / Archive: Admins or authenticated owner can delete or archive
      allow delete: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId)
      );
    }

    // 6. Partner Orders (/partner_orders/{orderId})
    match /partner_orders/{orderId} {
      // Partners can only read orders belonging to their store; consumers read their own orders
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        (isPartnerOwner(resource.data.partnerId) || resource.data.userId == request.auth.uid)
      );
      // Orders can be created by authenticated shoppers or admin
      allow create: if isAdmin() || (request.auth != null && request.resource.data.userId == request.auth.uid);
      // Partners can only update fulfillment tracking fields; cannot modify financial balances
      allow update: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'courierCarrier', 'trackingNumber', 'statusHistory', 'updatedAt', 'internalNotes'
        ])
      );
      allow delete: if isAdmin();
    }

    // 7. Partner Fulfillments (/partner_fulfillments/{fulfillmentId})
    match /partner_fulfillments/{fulfillmentId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId)
      );
      allow create, update: if isAdmin() || (
        request.auth != null &&
        isPartnerOwner(request.resource.data.partnerId)
      );
      allow delete: if isAdmin();
    }

    // 8. Partner Fulfillment Audit Logs (/partner_fulfillment_audit_logs/{logId})
    match /partner_fulfillment_audit_logs/{logId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId)
      );
      allow create: if isAdmin() || (
        request.auth != null &&
        isPartnerOwner(request.resource.data.partnerId)
      );
      allow update, delete: if isAdmin();
    }

    // 9. Competitions & Challenges (/competitions/{competitionId})
    match /competitions/{competitionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Competition Submissions (/competition_submissions/{submissionId} & /competitionSubmissions/{submissionId})
    match /competition_submissions/{submissionId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.userId != null;
      allow update, delete: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      );
    }
    match /competitionSubmissions/{submissionId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.userId != null;
      allow update, delete: if isAdmin() || (
        request.auth != null && (
          resource.data.userId == request.auth.uid ||
          resource.data.userId == request.auth.token.email
        )
      );
    }

    // 11. Competition Votes (/competition_votes/{voteId})
    match /competition_votes/{voteId} {
      allow read: if true;
      allow create: if request.auth != null || request.resource.data.userId != null;
      allow update, delete: if isAdmin();
    }

    // 12. Admin Dashboard Settings (/admin_settings/{settingId})
    match /admin_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // 13. Partner Product Audit Logs (/partner_product_audit_logs/{logId})
    match /partner_product_audit_logs/{logId} {
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId)
      );
      allow create: if isAdmin() || (
        request.auth != null &&
        isPartnerOwner(request.resource.data.partnerId)
      );
      allow update, delete: if isAdmin();
    }

    // 14. User Authorized Reviews (/user_authorized_reviews/{reviewId})
    match /user_authorized_reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }

    // 15. Security Audit Logs (/security_audit_logs/{logId})
    match /security_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // 16. Subscriptions, Payments & Entitlements
    match /subscriptions/{subId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid == subId));
      allow write: if isAdmin();
    }
    match /subscription_events/{eventId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /entitlements/{entId} {
      allow read: if isAdmin() || (request.auth != null && (resource.data.userId == request.auth.uid || request.auth.uid == entId));
      allow write: if isAdmin();
    }
    match /vto_usage/{usageId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payment_events/{eventId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payment_orders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /reconciliation_queue/{id} {
      allow read, write: if isAdmin();
    }
    match /refunds/{refundId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    // 17. Notifications & Devices
    match /user_notifications/{notifId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update, delete: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
    }
    match /user_devices/{deviceId} {
      allow read, write: if isAdmin() || request.auth != null;
    }
    match /notification_tokens/{tokenId} {
      allow read, write: if isAdmin() || (request.auth != null && (
        (request.resource != null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      ));
    }

    // 18. Blog Posts (/blog/{postId})
    match /blog/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 19. Price History & Merchandising
    match /price_history/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /merchandising_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || request.auth != null;
      allow update, delete: if isAdmin();
    }

    // 20. Affiliate Clicks Telemetry
    match /affiliate_clicks/{clickId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 21. Rate Limits
    match /rate_limits/{docKey} {
      allow read, write: if true;
    }

    // 22. Partner Analytics Events (/partner_analytics_events/{eventId})
    match /partner_analytics_events/{eventId} {
      // Ingest: Authenticated or anonymous consumer telemetry events with valid eventType
      allow create: if request.resource.data.eventType in [
        'product_impression', 'product_detail_view', 'outbound_buy_click',
        'partner_product_created', 'partner_product_updated', 'partner_product_submitted', 'try_on_started'
      ] && request.resource.data.partnerId != null;

      // Read: Admins or the owning partner can query their analytics
      allow read: if isAdmin() || (
        request.auth != null &&
        resource != null &&
        isPartnerOwner(resource.data.partnerId)
      );

      // Immutability: Analytics records cannot be updated or deleted by clients
      allow update, delete: if isAdmin();
    }

    // STRICT DEFAULT DENY: All unlisted collections are completely blocked
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
