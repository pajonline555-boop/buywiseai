# BuyWise AI Environment Variable Template
# Copy this file to .env.local in web/ or root and populate with your credentials.

# 1. AI Assistant Provider Credentials
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_VISION_MODEL=gpt-4o

HF_TOKEN=YOUR_HUGGINGFACE_TOKEN_HERE

# 2. Firebase Public Client Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pajonline-shopping.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://pajonline-shopping-default-rtdb.asia-southeast1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pajonline-shopping
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pajonline-shopping.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# 3. Retailer Affiliate Credentials
AMAZON_PAAPI_KEY=YOUR_AMAZON_KEY
AMAZON_PAAPI_SECRET=YOUR_AMAZON_SECRET
AMAZON_ASSOCIATE_TAG=pajonline-21
AMAZON_PAAPI_HOST=webservices.amazon.in
AMAZON_PAAPI_REGION=eu-west-1

FLIPKART_AFFILIATE_ID=YOUR_FLIPKART_ID
FLIPKART_AFFILIATE_TOKEN=YOUR_FLIPKART_TOKEN

EBAY_CLIENT_ID=YOUR_EBAY_ID
EBAY_CLIENT_SECRET=YOUR_EBAY_SECRET
EBAY_MARKETPLACE_ID=EBAY-IN

# 4. Payment Gateway Sandbox Credentials
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# 5. System Cron Secret
CRON_SECRET=YOUR_CRON_SECRET_HERE
